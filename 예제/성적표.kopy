# 사전으로 성적 관리하기

성적 = {
    "김철수": [90, 85, 77],
    "이영희": [95, 92, 98],
    "박민수": [60, 72, 68],
}

함수 학점(평균):
    만약 평균 >= 90:
        반환 "A"
    아니면 만약 평균 >= 80:
        반환 "B"
    아니면 만약 평균 >= 70:
        반환 "C"
    반환 "F"

출력(f"{'이름':<6}{'평균':>6}  학점")
출력("-" * 20)
반복 이름, 점수들 안에 성적.항목들():
    평균 = 합계(점수들) / 길이(점수들)
    출력(f"{이름:<6}{평균:>8.1f}  {학점(평균)}")

일등 = 최대(성적, key=람다 이름: 합계(성적[이름]))
출력(f"\n1등은 {일등}!")
