# 함수
함수 피보나치(n):
    만약 n < 2:
        반환 n
    반환 피보나치(n - 1) + 피보나치(n - 2)

출력("피보나치:", [피보나치(i) 반복 i 안에 범위(10)])

# 리스트와 메서드
과일들 = ["사과", "바나나"]
과일들.추가("포도")
출력("과일 개수:", 길이(과일들))
출력(", ".합치기(정렬(과일들)))

# 클래스
클래스 강아지:
    함수 생성자(자기, 이름):
        자기.이름 = 이름

    함수 짖기(자기):
        출력(f"{자기.이름}: 멍멍!")

바둑이 = 강아지("바둑이")
바둑이.짖기()

# 예외 처리
시도:
    결과 = 10 / 0
예외 영나누기오류:
    출력("0으로 나눌 수 없어요!")
마침내:
    출력("계산 끝")

# 참/거짓
비었나 = 길이([]) == 0
만약 비었나 그리고 아님 거짓:
    출력("논리 연산도 잘 돼요")

# 파이썬 모듈도 그대로 쓸 수 있어요
가져오기 math
출력("원주율:", 반올림(math.pi, 3))
